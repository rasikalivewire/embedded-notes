#include <ESP8266WiFi.h>
#include <ESP8266HTTPClient.h>
#include <DHT.h>

#define DHTPIN 2     // GPIO2 is physical pin D4 on NodeMCU/Wemos boards
#define DHTTYPE DHT11

DHT d(DHTPIN, DHTTYPE);

// Target Access Point Details
const char* ssid = "ESP";
const char* password = "12345678";
const char* serverUrl = "http://192.168.4.1/data";

void setup() {
  Serial.begin(115200);
  delay(1000);

  // Enable ESP8266 internal pull-up resistor for pin D4
  pinMode(DHTPIN, INPUT_PULLUP);
  d.begin();
  delay(1000); 

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.println("\n==================================");
  Serial.print("Connecting to Device 2 AP");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConnected to Device 2!");
  Serial.print("Device 1 Assigned Local IP: ");
  Serial.println(WiFi.localIP());
  Serial.println("==================================");
}

void loop() {
  float temperature = d.readTemperature();
  float humidity = d.readHumidity();

  // Validate sensor readings
  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("DHT11 Sensor Reading Failed. Check wiring on D4.");
    delay(2000);
    return;
  }

  Serial.print("Sensor Read -> Temp: ");
  Serial.print(temperature);
  Serial.print(" °C | Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  if (WiFi.status() == WL_CONNECTED) {
    WiFiClient client;
    HTTPClient http;

    // Build URL query payload
    String requestUrl = String(serverUrl) + "?temperature=" + String(temperature, 1) + "&humidity=" + String(humidity, 1);

    http.begin(client, requestUrl);
    int httpResponseCode = http.GET();

    if (httpResponseCode > 0) {
      Serial.print("Data Sent. Server Response Code: ");
      Serial.println(httpResponseCode); // 200 means successful send
    } else {
      Serial.print("Data Send Failed. HTTP Error Code: ");
      Serial.println(httpResponseCode);
    }

    http.end();
  } else {
    Serial.println("WiFi Disconnected. Attempting Reconnect...");
    WiFi.reconnect();
  }

  delay(5000); // Read and transmit every 5 seconds
}
