#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// Access Point Credentials
const char* ssid = "ESP";
const char* password = "12345678";

ESP8266WebServer server(80);

// Data variables stored in memory
float temperature = 0.0;
float humidity = 0.0;

// Web page HTML handler
void handleRoot() {
  String webpage = "<!DOCTYPE html><html><head>";
  webpage += "<meta http-equiv='refresh' content='2'>"; // Refreshes browser page every 2 seconds
  webpage += "<meta name='viewport' content='width=device-width, initial-scale=1.0'>";
  webpage += "<style>";
  webpage += "body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; background-color: #f4f4f9; }";
  webpage += ".card { display: inline-block; background: white; padding: 20px 40px; margin: 10px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }";
  webpage += "h1 { color: #333; } h2 { color: #007bff; margin: 0; }";
  webpage += "</style><title>Weather Monitor</title></head><body>";
  
  webpage += "<h1>ESP8266 Weather Station</h1>";
  webpage += "<div class='card'><h3>Temperature</h3><h2>" + String(temperature, 1) + " &deg;C</h2></div>";
  webpage += "<div class='card'><h3>Humidity</h3><h2>" + String(humidity, 1) + " %</h2></div>";
  webpage += "</body></html>";

  server.send(200, "text/html", webpage);
}

// Data endpoint handler (/data)
void receiveData() {
  if (server.hasArg("temperature")) {
    temperature = server.arg("temperature").toFloat();
  }

  if (server.hasArg("humidity")) {
    humidity = server.arg("humidity").toFloat();
  }

  Serial.print("Data Received -> Temp: ");
  Serial.print(temperature);
  Serial.print(" °C | Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  server.send(200, "text/plain", "Data Received Successfully");
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  // Set up ESP8266 as Access Point (AP)
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  Serial.println("\n==================================");
  Serial.println("Device 2 (Receiver) Started");
  Serial.print("Server IP Address: ");
  Serial.println(WiFi.softAPIP()); // Default: 192.168.4.1
  Serial.println("==================================");

  // Bind route functions
  server.on("/", handleRoot);
  server.on("/data", receiveData);

  server.begin();
  Serial.println("HTTP Server Active");
}

void loop() {
  server.handleClient();
}
